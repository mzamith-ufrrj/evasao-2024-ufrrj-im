source("~/Documents/02-Trabalhos/01-Orientacoes.artigos/2024-evasao/R/fontes-git/002-distribuicao-periodos.R")
source("~/Documents/02-Trabalhos/01-Orientacoes.artigos/2024-evasao/R/fontes-git/002-distribuicao-periodos.R")
#library(lubridate)
library(dplyr)
library(xtable)
library(plyr)
library(ggplot2)
rm(list = ls())
print("Distribuição dos discentes pelas entradas ao longo dos anos de acordo com o status")
print("Entradas entre 2010 até 2024")
discentes <-read.table("discentes.csv", header = T, quote = '"',
row.names = NULL,
stringsAsFactors = FALSE, sep=",")
discentes$matricula <- as.character(discentes$matricula)
discentes$anoPeriodoLetivoInicial <- as.character(discentes$anoPeriodoLetivoInicial)
sapply(discentes, class)
df_colunas <- discentes %>% dplyr::group_by(situacao) %>%
dplyr::summarise(total=n()) %>%
as.data.frame()
df_linhas <- discentes %>% dplyr::group_by(anoEntrada) %>%
dplyr::summarise(total=n()) %>%
as.data.frame()
colunas <- as.list(df_colunas$situacao)
colunas <- append(colunas, "TOTAL")
linhas <-  as.list(df_linhas$anoEntrada)
linhas <- append(linhas, "TOTAL")
x <- length(colunas)
y <- length(linhas)
A <- matrix(0, nrow = y, ncol = x, dimnames = list(as.character(linhas), as.character(colunas)))
df4 <- discentes %>% dplyr::group_by(anoEntrada, situacao) %>%
dplyr::summarise(total=n()) %>%
as.data.frame()
for (i in 1:length(df4$anoEntrada)){
A[as.character(df4$anoEntrada[i]), df4$situacao[i]] <- df4$total[i]
}
totalR <- rowSums(A)
totalC <- colSums(A)
A['TOTAL', ] <- totalC
A[,'TOTAL'] <- totalR
#print(xtable::xtable(A, type = "latex", file = "tabela.tex")) #não ta exportando para o arquivo
print(A)
#
print("Construíndo gráfico")
print(A)
df_cumsum <- plyr::ddply(df4, "anoEntrada",
transform, label_ypos=cumsum(total))
print(df_cumsum)
g <- ggplot2::ggplot(data=df_cumsum, aes(x=as.character(anoEntrada), y=total, fill=situacao)) +
geom_bar(stat="identity")+
coord_cartesian(ylim = c(0, 71)) +
scale_y_continuous(breaks = seq(0, 71, by = 5)) +
labs(x = "Ano/Período", y = "Entradas - qtde. discentes") +
#geom_text(aes(y=label_ypos, label=total), vjust=0, color="black", size=4)+
scale_fill_manual(values=c('green', 'blue', 'yellow', 'red', 'cyan'),  name = "STATUS")+
#scale_fill_brewer(palette="Blues", name = "STATUS")+
theme_bw() +
theme(#legend.position = "none",
legend.position = "top",
axis.text.x = element_text(angle = 45, vjust = 1, hjust=0.8),
text=element_text(size=16), #change font size of all text
axis.text=element_text(size=20), #change font size of axis text
axis.title=element_text(size=22), #change font size of axis titles
plot.title=element_text(size=16), #change font size of plot title
legend.text=element_text(size=16), #change font size of legend text
legend.title=element_text(size=22))
print(g)
ggsave(filename = "distribuicaoDiscentesEntradas.pdf", width = 20, height = 10)
#library(lubridate)
library(dplyr)
library(xtable)
library(plyr)
library(ggplot2)
rm(list = ls())
print("Distribuição dos discentes pelas entradas ao longo dos anos de acordo com o status")
print("Entradas entre 2010 até 2024")
discentes <-read.table("discentes.csv", header = T, quote = '"',
row.names = NULL,
stringsAsFactors = FALSE, sep=",")
discentes$matricula <- as.character(discentes$matricula)
discentes$anoPeriodoLetivoInicial <- as.character(discentes$anoPeriodoLetivoInicial)
sapply(discentes, class)
df_colunas <- discentes %>% dplyr::group_by(situacao) %>%
dplyr::summarise(total=n()) %>%
as.data.frame()
df_linhas <- discentes %>% dplyr::group_by(anoEntrada) %>%
dplyr::summarise(total=n()) %>%
as.data.frame()
colunas <- as.list(df_colunas$situacao)
colunas <- append(colunas, "TOTAL")
linhas <-  as.list(df_linhas$anoEntrada)
linhas <- append(linhas, "TOTAL")
x <- length(colunas)
y <- length(linhas)
A <- matrix(0, nrow = y, ncol = x, dimnames = list(as.character(linhas), as.character(colunas)))
df4 <- discentes %>% dplyr::group_by(anoEntrada, situacao) %>%
dplyr::summarise(total=n()) %>%
as.data.frame()
for (i in 1:length(df4$anoEntrada)){
A[as.character(df4$anoEntrada[i]), df4$situacao[i]] <- df4$total[i]
}
totalR <- rowSums(A)
totalC <- colSums(A)
A['TOTAL', ] <- totalC
A[,'TOTAL'] <- totalR
#print(xtable::xtable(A, type = "latex", file = "tabela.tex")) #não ta exportando para o arquivo
print(A)
#
print("Construíndo gráfico")
print(A)
df_cumsum <- plyr::ddply(df4, "anoEntrada",
transform, label_ypos=cumsum(total))
print(df_cumsum)
g <- ggplot2::ggplot(data=df_cumsum, aes(x=as.character(anoEntrada), y=total, fill=situacao)) +
geom_bar(stat="identity")+
coord_cartesian(ylim = c(0, 71)) +
scale_y_continuous(breaks = seq(0, 71, by = 5)) +
labs(x = "Ano/Período", y = "Entradas - qtde. discentes") +
#geom_text(aes(y=label_ypos, label=total), vjust=0, color="black", size=4)+
scale_fill_manual(values=c('green', 'blue', 'yellow', 'red', 'cyan'),  name = "STATUS")+
#scale_fill_brewer(palette="Blues", name = "STATUS")+
theme_bw() +
theme(#legend.position = "none",
legend.position = "top",
axis.text.x = element_text(angle = 45, vjust = 1, hjust=0.8),
text=element_text(size=16), #change font size of all text
axis.text=element_text(size=20), #change font size of axis text
axis.title=element_text(size=22), #change font size of axis titles
plot.title=element_text(size=16), #change font size of plot title
legend.text=element_text(size=16), #change font size of legend text
legend.title=element_text(size=22))
#Imprimi e salva no disco o gráfico
print(g)
ggsave(filename = "distribuicaoDiscentesEntradas.pdf", width = 20, height = 10)
